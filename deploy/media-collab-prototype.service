[Unit]
Description=Media Collaboration Prototype
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/media-collab-prototype
Environment=NODE_ENV=production
ExecStart=/bin/bash -ic 'exec /usr/bin/npm run start'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
