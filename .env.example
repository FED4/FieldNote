# Tencent Cloud account credentials shared by ASR and TIIA.
# Never commit real values. The application will only read them server-side.
TENCENT_CLOUD_SECRET_ID=
TENCENT_CLOUD_SECRET_KEY=
TENCENT_CLOUD_APP_ID=

# Service regions. Keep these separate so either service can move independently.
TENCENT_ASR_REGION=ap-guangzhou
TENCENT_TIIA_REGION=ap-guangzhou

# Realtime ASR defaults for Mandarin meeting audio (16 kHz).
TENCENT_ASR_ENGINE_MODEL_TYPE=16k_zh
TENCENT_ASR_VOICE_FORMAT=pcm

# VITA uses its independently issued API key (not SecretId/SecretKey).
TENCENT_VITA_API_KEY=

# Optional multimodal reasoning model identifier.
TENCENT_HUNYUAN_MODEL=

# Server-side prototype metadata store. Original browser-local media is not stored here.
FIELDNOTE_DATA_DIR=/data/fieldnote-prototype
